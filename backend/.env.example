# RepoLens Backend Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001
TAVILY_API_KEY=your_tavily_api_key_here
GITHUB_TOKEN=
ALLOWED_DOMAINS=github.com,stackoverflow.com,docs.python.org,developer.mozilla.org
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=repolens
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
DATA_DIR=./data
SQLITE_PATH=./data/repolens.db
MAX_FILES=2000
MAX_FILE_KB=200
MAX_AGENT_STEPS=12
MAX_SEARCHES=5
MAX_TOKENS_PER_SESSION=20000
REQUEST_TIMEOUT_S=60
CORS_ORIGINS=http://localhost:5173
PORT=8000
